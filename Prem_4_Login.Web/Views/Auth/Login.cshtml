@model Prem_4_Login.Web.DTOs.LoginRequest

@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-5">

            <div class="card shadow">

                <div class="card-header">
                    <h3 class="text-center">
                        User Login
                    </h3>
                </div>

                <div class="card-body">

                    <form asp-action="Login"
                          asp-controller="Auth"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger">
                        </div>


                        <div class="mb-3">

                            <label asp-for="LoginId"
                                   class="form-label">
                                User Id
                            </label>

                            <input asp-for="LoginId"
                                   class="form-control"
                                   placeholder="Enter User Id" />

                            <span asp-validation-for="LoginId"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="Password"
                                   class="form-label">
                                Password
                            </label>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Enter Password" />

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>

                        </div>


                        <button type="submit"
                                class="btn btn-primary w-100">

                            Login

                        </button>

                    </form>

                    <hr />

                    <div class="text-center">

                        <a href="#">
                            New User? Register Here
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}